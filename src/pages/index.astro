---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: 900px;
				margin: 0 auto;
				padding: 2rem 1rem;
			}
			.hero {
				margin-bottom: 2.5rem;
			}
			.hero h1 {
				margin-bottom: 0.75rem;
				font-size: 2.5rem;
			}
			.hero .subtitle {
				margin-bottom: 1rem;
				font-size: 1.1rem;
				color: rgb(var(--gray-dark));
			}
			.hero .tagline {
				color: rgb(var(--gray-dark));
				line-height: 1.6;
			}
			.orientation {
				margin-bottom: 1.5rem;
				line-height: 1.8;
			}
			.next-steps {
				margin-bottom: 3rem;
			}
			.link-item {
				margin-bottom: 1.5rem;
			}
			.link-item a {
				font-size: 1.1rem;
				font-weight: 600;
			}
			.link-item .description {
				margin-top: 0.5rem;
				color: rgb(var(--gray));
				line-height: 1.6;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Nick DiPreta</h1>
				<p class="subtitle">Software engineer studying ethical responsibility in software systems</p>
				<p class="tagline">I write about how design decisions in software and AI shape accountability, redistribute risk, and influence real world outcomes.</p>
			</section>

			<section class="orientation">
				<p>I study technology as a form of governance. This site is a place to develop case based analyses of software failures and to think more carefully about how ethical responsibility gets embedded, deferred, or obscured in technical systems.</p>
			</section>

			<section class="next-steps">
				<div class="link-item">
					<a href="/blog/on-responsibility-in-software">Introduction: Studying Ethical Responsibility in Software</a>
					<p class="description">An overview of what this blog is about and how I plan to approach it.</p>
				</div>

				<div class="link-item">
					<a href="/about">About</a>
					<p class="description">Background, interests, and what I am working on.</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
