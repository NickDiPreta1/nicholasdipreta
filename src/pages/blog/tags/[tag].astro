---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';
import FormattedDate from '../../../components/FormattedDate.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

	return tags.map((tag) => {
		const tagPosts = posts
			.filter((post) => post.data.tags.includes(tag))
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
		return {
			params: { tag },
			props: { posts: tagPosts, tag },
		};
	});
}

interface Props {
	posts: Awaited<ReturnType<typeof getCollection<'blog'>>>;
	tag: string;
}

const { posts, tag } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Posts tagged "${tag}" | ${SITE_TITLE}`} description={`All blog posts tagged with "${tag}".`} />
		<style>
			main {
				max-width: 960px;
				width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}

			.page-header {
				margin-bottom: 2rem;
			}

			.page-heading {
				font-size: 2rem;
				font-weight: 700;
				color: rgb(var(--black));
				margin: 0 0 0.5rem;
				letter-spacing: -0.02em;
			}

			.back-link {
				font-size: 0.9rem;
				color: var(--accent);
			}

			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}

			ul li {
				width: calc(50% - 0.75rem);
				display: flex;
			}

			ul li a {
				display: flex;
				flex-direction: column;
				width: 100%;
				padding: 1.25rem;
				background: var(--surface);
				border: 1px solid var(--border-subtle);
				border-radius: 16px;
				text-decoration: none;
				transition: border-color var(--transition-fast),
					box-shadow var(--transition-fast),
					transform var(--transition-fast);
			}

			ul li a:hover {
				border-color: var(--accent);
				box-shadow: var(--shadow-md);
				transform: translateY(-2px);
			}

			ul li a:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 2px;
			}

			ul li img {
				width: 100%;
				margin-bottom: 1rem;
				border-radius: 12px;
			}

			.title {
				margin: 0 0 0.5rem 0;
				color: rgb(var(--black));
				font-size: 1.25rem;
				font-weight: 600;
				line-height: 1.3;
				transition: color var(--transition-fast);
			}

			ul li a:hover .title {
				color: var(--accent);
			}

			.description {
				margin: 0.25rem 0 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
				line-height: 1.5;
			}

			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.875rem;
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: 0.75rem;
			}

			.tag {
				display: inline-flex;
				align-items: center;
				padding: 0.2em 0.6em;
				font-size: 0.75rem;
				color: var(--accent);
				border: 1px solid var(--accent);
				border-radius: 9999px;
			}

			.tag.active {
				background: var(--accent);
				color: white;
			}

			@media (max-width: 720px) {
				main {
					padding: 2em 1em;
				}
				.page-heading {
					font-size: 1.5rem;
				}
				ul {
					gap: 1rem;
				}
				ul li {
					width: 100%;
				}
				ul li a {
					padding: 1rem;
				}
				.title {
					font-size: 1.1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="page-header">
					<h1 class="page-heading">Tagged: {tag}</h1>
					<a href="/blog" class="back-link">&larr; All posts</a>
				</div>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}`}>
									{post.data.heroImage && (
										<Image
											width={720}
											height={360}
											src={post.data.heroImage}
											alt={`Cover image for ${post.data.title}`}
											loading="lazy"
										/>
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									{post.data.description && (
										<p class="description">{post.data.description}</p>
									)}
									{post.data.tags.length > 0 && (
										<div class="tags">
											{post.data.tags.map((t: string) => (
												<span class:list={["tag", { active: t === tag }]}>{t}</span>
											))}
										</div>
									)}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
