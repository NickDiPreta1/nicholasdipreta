---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description="Blog page" />
		<style>
			main {
				max-width: 960px;
				width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}

			/* Page header */
			section::before {
				content: "Blog";
				display: block;
				font-size: 2rem;
				font-weight: 700;
				color: rgb(var(--black));
				margin-bottom: 2rem;
				letter-spacing: -0.02em;
			}

			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}

			/* Blog post cards */
			ul li {
				width: calc(50% - 0.75rem);
			}

			ul li a {
				display: block;
				padding: 1.25rem;
				background: var(--surface);
				border: 1px solid var(--border-subtle);
				border-radius: 16px;
				text-decoration: none;
				transition: border-color var(--transition-base),
					box-shadow var(--transition-base),
					transform var(--transition-base);
			}

			ul li a:hover {
				border-color: var(--accent);
				box-shadow: var(--shadow-hover);
				transform: translateY(-4px);
			}

			ul li a:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 2px;
			}

			ul li img {
				width: 100%;
				margin-bottom: 1rem;
				border-radius: 12px;
				transition: transform var(--transition-base);
			}

			ul li a:hover img {
				transform: scale(1.02);
			}

			.title {
				margin: 0 0 0.5rem 0;
				color: rgb(var(--black));
				font-size: 1.25rem;
				font-weight: 600;
				line-height: 1.3;
				hyphens: auto;
				-webkit-hyphens: auto;
				transition: color var(--transition-fast);
			}

			ul li a:hover .title {
				color: var(--accent);
			}

			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.875rem;
			}

			/* Featured post (first item) */
			ul li:first-child {
				width: 100%;
				margin-bottom: 0.5rem;
			}

			ul li:first-child a {
				padding: 1.5rem;
				background: linear-gradient(
					135deg,
					var(--accent-subtle) 0%,
					rgba(var(--gray-light), 0.3) 100%
				);
				border: 1px solid rgba(35, 55, 255, 0.2);
			}

			ul li:first-child a:hover {
				border-color: var(--accent);
			}

			ul li:first-child img {
				border-radius: 12px;
			}

			ul li:first-child .title {
				font-size: 1.75rem;
				text-align: center;
			}

			ul li:first-child .date {
				text-align: center;
			}

			@media (max-width: 720px) {
				main {
					padding: 2em 1em;
				}
				section::before {
					font-size: 1.5rem;
					margin-bottom: 1.5rem;
				}
				ul {
					gap: 1rem;
				}
				ul li {
					width: 100%;
				}
				ul li a {
					padding: 1rem;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.25rem;
				}
				.title {
					font-size: 1.1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul class="reveal-stagger">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}`}>
									{post.data.heroImage && (
										<img
											width={720}
											height={360}
											src={post.data.heroImage.src}
											alt={`Cover image for ${post.data.title}`}
										/>
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
