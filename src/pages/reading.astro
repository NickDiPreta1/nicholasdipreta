---
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import FormattedDate from '../components/FormattedDate.astro';

const allBooks = await getCollection('reading');

const currentlyReading = allBooks.filter(b => b.data.status === 'reading');
const finishedBooks = allBooks
	.filter(b => b.data.status !== 'reading')
	.sort((a, b) => (b.data.finishedDate?.valueOf() || 0) - (a.data.finishedDate?.valueOf() || 0));

const currentlyReadingWithContent = await Promise.all(
	currentlyReading.map(async (book) => {
		const { Content } = await render(book);
		return { ...book, Content };
	})
);

const finishedWithContent = await Promise.all(
	finishedBooks.map(async (book) => {
		const { Content } = await render(book);
		return { ...book, Content };
	})
);

const categories = [...new Set(finishedBooks.map(b => b.data.category).filter(Boolean))] as string[];

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Reading ${currentYear} | ${SITE_TITLE}`} description={`Books I've read in ${currentYear}`} />
		<style>
			main {
				max-width: 960px;
				width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}

			section::before {
				content: "Reading List";
				display: block;
				font-size: 2rem;
				font-weight: 700;
				color: rgb(var(--black));
				margin-bottom: 0.5rem;
				letter-spacing: -0.02em;
			}

			.intro {
				color: rgb(var(--gray-dark));
				margin-bottom: 2rem;
				font-size: 1.05rem;
				line-height: 1.5;
			}

			.subtitle {
				color: rgb(var(--gray));
				margin-bottom: 1.5rem;
			}

			.section-title {
				font-size: 1.25rem;
				font-weight: 600;
				color: rgb(var(--black));
				margin: 0 0 1rem 0;
			}

			.currently-reading {
				margin-bottom: 2.5rem;
			}

			.currently-reading .book-item {
				border-left: 3px solid var(--accent);
			}

			.filter-tabs {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 2rem;
			}

			.filter-tab {
				padding: 0.5rem 1rem;
				border: 1px solid var(--border-subtle);
				border-radius: 20px;
				background: var(--surface);
				color: rgb(var(--gray));
				font-size: 0.875rem;
				cursor: pointer;
				transition: all var(--transition-base);
				text-transform: capitalize;
			}

			.filter-tab:hover {
				border-color: var(--accent);
				color: rgb(var(--black));
			}

			.filter-tab.active {
				background: var(--accent);
				border-color: var(--accent);
				color: white;
			}

			.book-list {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.book-item {
				padding: 1.25rem;
				background: var(--surface);
				border: 1px solid var(--border-subtle);
				border-radius: 16px;
				transition: border-color var(--transition-base),
					box-shadow var(--transition-base),
					opacity var(--transition-base),
					transform var(--transition-base);
			}

			.book-item.hiding {
				opacity: 0;
				transform: scale(0.95);
			}

			.book-item.hidden {
				display: none;
			}

			.book-item:hover {
				border-color: var(--accent);
				box-shadow: var(--shadow-hover);
			}

			.book-header {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				gap: 1rem;
				margin-bottom: 0.75rem;
			}

			.book-title {
				margin: 0;
				font-size: 1.25rem;
				font-weight: 600;
				color: rgb(var(--black));
				line-height: 1.3;
			}

			.book-author {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}

			.book-meta {
				display: flex;
				align-items: center;
				gap: 1rem;
				flex-shrink: 0;
			}

			.book-date {
				color: rgb(var(--gray));
				font-size: 0.875rem;
			}

			.book-rating {
				color: var(--accent);
				font-size: 0.9rem;
				letter-spacing: 0.1em;
			}

			.book-category {
				display: inline-block;
				padding: 0.2rem 0.6rem;
				font-size: 0.75rem;
				font-weight: 500;
				text-transform: capitalize;
				border-radius: 12px;
				background: var(--border-subtle);
				color: rgb(var(--gray-dark));
			}

			.book-category[data-category="fantasy"] {
				background: #e8daff;
				color: #5b21b6;
			}

			.book-category[data-category="sci-fi"] {
				background: #d1fae5;
				color: #065f46;
			}

			.book-category[data-category="non-fiction"] {
				background: #dbeafe;
				color: #1e40af;
			}

			.book-category[data-category="fiction"] {
				background: #fef3c7;
				color: #92400e;
			}

			:root.dark .book-category[data-category="fantasy"] {
				background: #4c1d95;
				color: #e8daff;
			}

			:root.dark .book-category[data-category="sci-fi"] {
				background: #064e3b;
				color: #d1fae5;
			}

			:root.dark .book-category[data-category="non-fiction"] {
				background: #1e3a8a;
				color: #dbeafe;
			}

			:root.dark .book-category[data-category="fiction"] {
				background: #78350f;
				color: #fef3c7;
			}

			.book-review {
				margin-top: 1rem;
				padding-top: 1rem;
				border-top: 1px solid var(--border-subtle);
				color: rgb(var(--gray-dark));
				font-size: 0.95rem;
				line-height: 1.6;
			}

			.book-review :global(p:first-child) {
				margin-top: 0;
			}

			.book-review :global(p:last-child) {
				margin-bottom: 0;
			}

			.empty-state {
				text-align: center;
				padding: 3rem 1rem;
				color: rgb(var(--gray));
			}

			@media (max-width: 720px) {
				main {
					padding: 2em 1em;
				}
				section::before {
					font-size: 1.5rem;
				}
				.book-header {
					flex-direction: column;
					gap: 0.5rem;
				}
				.book-meta {
					width: 100%;
					justify-content: space-between;
				}
				.book-title {
					font-size: 1.1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<p class="intro">I read mostly fantasy and non-fiction.</p>

				{currentlyReadingWithContent.length > 0 && (
					<div class="currently-reading">
						<h2 class="section-title">Currently Reading</h2>
						<ul class="book-list">
							{currentlyReadingWithContent.map((book) => (
								<li class="book-item">
									<div class="book-header">
										<div>
											<h3 class="book-title">{book.data.title}</h3>
											<p class="book-author">by {book.data.author}</p>
										</div>
										<div class="book-meta">
											{book.data.category && (
												<span class="book-category" data-category={book.data.category}>
													{book.data.category}
												</span>
											)}
										</div>
									</div>
									{book.body && (
										<div class="book-review">
											<book.Content />
										</div>
									)}
								</li>
							))}
						</ul>
					</div>
				)}

				<p class="subtitle"><span class="book-count">{finishedBooks.length}</span> books finished in {currentYear}</p>

				{categories.length > 0 && (
					<div class="filter-tabs">
						<button class="filter-tab active" data-category="all">All</button>
						{categories.map((category) => (
							<button class="filter-tab" data-category={category}>{category}</button>
						))}
					</div>
				)}
				{finishedWithContent.length > 0 ? (
					<ul class="book-list">
						{finishedWithContent.map((book) => (
							<li class="book-item" data-category={book.data.category || 'uncategorized'}>
								<div class="book-header">
									<div>
										<h3 class="book-title">{book.data.title}</h3>
										<p class="book-author">by {book.data.author}</p>
									</div>
									<div class="book-meta">
										{book.data.category && (
											<span class="book-category" data-category={book.data.category}>
												{book.data.category}
											</span>
										)}
										{book.data.finishedDate && (
											<span class="book-date">
												<FormattedDate date={book.data.finishedDate} />
											</span>
										)}
										{book.data.rating && (
											<span class="book-rating">
												{'★'.repeat(book.data.rating)}{'☆'.repeat(5 - book.data.rating)}
											</span>
										)}
									</div>
								</div>
								{book.body && (
									<div class="book-review">
										<book.Content />
									</div>
								)}
							</li>
						))}
					</ul>
				) : (
					<p class="empty-state">No books yet this year. Check back soon!</p>
				)}
			</section>
		</main>
		<Footer />
		<script>
			const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
			const finishedList = document.querySelector('.book-list:not(.currently-reading .book-list)');
			const finishedBooks = finishedList?.querySelectorAll<HTMLLIElement>('.book-item') || [];
			const countEl = document.querySelector<HTMLSpanElement>('.book-count');

			tabs.forEach(tab => {
				tab.addEventListener('click', () => {
					tabs.forEach(t => t.classList.remove('active'));
					tab.classList.add('active');

					const category = tab.dataset.category;
					let visibleCount = 0;

					finishedBooks.forEach(book => {
						const shouldShow = category === 'all' || book.dataset.category === category;

						if (shouldShow) {
							book.classList.remove('hiding', 'hidden');
							visibleCount++;
						} else {
							book.classList.add('hiding');
							setTimeout(() => {
								if (book.classList.contains('hiding')) {
									book.classList.add('hidden');
								}
							}, 200);
						}
					});

					if (countEl) {
						countEl.textContent = String(visibleCount);
					}
				});
			});
		</script>
	</body>
</html>
